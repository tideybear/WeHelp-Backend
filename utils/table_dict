CREATE TABLE `crm_master_data` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '序号',
  `namespace_id` tinyint(4) DEFAULT NULL COMMENT '项目空间ID',
  `customer_no` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '客户编号',
  `company_name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '公司名称',
  `company_name_en` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '公司英文名称',
  `short_name` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '公司简称',
  `source_id` int(10) unsigned DEFAULT NULL COMMENT '来源，sys_dict.id (dict_type=source)',
  `region_id` int(10) unsigned DEFAULT NULL COMMENT '区域，sys_dict.id (dict_type=region)',
  `country_id` int(10) unsigned DEFAULT NULL COMMENT '国家，sys_country.id',
  `customer_type_id` int(10) unsigned DEFAULT NULL COMMENT '客户性质，sys_dict.id',
  `industry_id` int(10) unsigned DEFAULT NULL COMMENT '行业，sys_dict.id',
  `company_size_id` int(10) unsigned DEFAULT NULL COMMENT '公司人数规模，sys_dict.id',
  `company_size_min` int(11) DEFAULT NULL COMMENT '人数下限（可选）',
  `company_size_max` int(11) DEFAULT NULL COMMENT '人数上限（可选）',
  `company_revenue` decimal(18,2) DEFAULT NULL COMMENT '公司销售额',
  `revenue_currency` char(3) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'USD' COMMENT '销售额币种',
  `website` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '网址',
  `customer_basic_info` text COLLATE utf8mb4_unicode_ci COMMENT '客户基本信息',
  `customer_needs` text COLLATE utf8mb4_unicode_ci COMMENT '客户需求',
  `follow_up_strategy` text COLLATE utf8mb4_unicode_ci COMMENT '跟进策略',
  `follow_up_status_id` int(10) unsigned DEFAULT NULL COMMENT '跟进状态，sys_dict.id',
  `first_cooperation_at` date DEFAULT NULL COMMENT '首次合作时间',
  `first_follow_up_date` date DEFAULT NULL COMMENT '首次跟进日期',
  `is_followed_up` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否跟进',
  `next_follow_up_at` datetime DEFAULT NULL COMMENT '下次跟进时间',
  `first_year_sales_potential` decimal(18,2) DEFAULT NULL COMMENT '首年销售潜力',
  `third_year_sales_potential` decimal(18,2) DEFAULT NULL COMMENT '第三年销售潜力',
  `potential_currency` char(3) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'USD' COMMENT '潜力金额币种',
  `has_visited` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否来访过',
  `owner_id` bigint(20) unsigned DEFAULT NULL COMMENT '负责人（销售）',
  `status` tinyint(4) NOT NULL DEFAULT '1' COMMENT '客户状态：1潜在 2跟进中 3已合作 4流失 5无效',
  `remark` text COLLATE utf8mb4_unicode_ci COMMENT '备注',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=13 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='客户主表';


CREATE TABLE `crm_contacts` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `namespace_id` tinyint(4) DEFAULT NULL COMMENT '项目空间ID',
  `customer_id` bigint(20) unsigned DEFAULT NULL COMMENT '客户ID',
  `name` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '姓名',
  `title` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '职位',
  `department` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '部门',
  `gender` tinyint(4) DEFAULT NULL COMMENT '性别：0未知 1男 2女',
  `phone` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '联系电话',
  `mobile` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '手机',
  `email` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '联系邮箱',
  `wechat` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '微信',
  `whatsapp` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'whatsapp',
  `linkedin` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'linkedin',
  `language` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '沟通语言，如 English/French/Arabic',
  `is_primary` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否主联系人',
  `birthday` date DEFAULT NULL,
  `notes` text COLLATE utf8mb4_unicode_ci COMMENT '备注',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=18 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='客户联系人';


CREATE TABLE `crm_follow_up_records` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `namespace_id` tinyint(4) DEFAULT NULL COMMENT '项目空间ID',
  `customer_id` bigint(20) unsigned NOT NULL,
  `contact_id` bigint(20) unsigned DEFAULT NULL COMMENT '对接人',
  `follow_up_at` datetime NOT NULL COMMENT '跟进时间',
  `follow_up_type_id` int(10) unsigned DEFAULT NULL COMMENT '方式：电话/邮件/拜访/会议，sys_dict.id',
  `content` text COLLATE utf8mb4_unicode_ci COMMENT '跟进内容',
  `result` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '跟进结果',
  `follow_up_status_id` int(10) unsigned DEFAULT NULL COMMENT '跟进后状态',
  `next_follow_up_at` datetime DEFAULT NULL COMMENT '下次跟进时间',
  `owner_id` bigint(20) unsigned DEFAULT NULL COMMENT '跟进人',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0',
  `inquiry_id` bigint(20) unsigned DEFAULT NULL COMMENT '询盘ID/线程ID',
  `direction` tinyint(4) DEFAULT NULL COMMENT '1客户来信 2我方发出 3内部备注',
  `channel` varchar(30) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'email/whatsapp/phone/website/meeting',
  `subject` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '主题',
  `message_body` mediumtext COLLATE utf8mb4_unicode_ci COMMENT '完整消息/邮件原文',
  `language` varchar(30) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '沟通语言',
  `related_product_id` bigint(20) unsigned DEFAULT NULL COMMENT '关联产品',
  `related_quote_id` bigint(20) unsigned DEFAULT NULL COMMENT '关联报价',
  `priority` tinyint(4) NOT NULL DEFAULT '0' COMMENT '优先级',
  `next_action` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '下一步动作',
  `external_message_id` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '外部消息ID，用于去重',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=23 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='跟进记录';



CREATE TABLE `crm_customer_products` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `namespace_id` tinyint(4) DEFAULT NULL COMMENT '项目空间ID',
  `customer_id` bigint(20) unsigned NOT NULL,
  `product_name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '产品名称',
  `product_category` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '产品类别',
  `spec` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '规格/型号',
  `demand_desc` text COLLATE utf8mb4_unicode_ci COMMENT '需求描述',
  `quantity` decimal(18,2) DEFAULT NULL COMMENT '数量',
  `unit` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '单位',
  `target_price` decimal(18,2) DEFAULT NULL COMMENT '目标价',
  `currency` char(3) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'USD' COMMENT '币种',
  `stage` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '需求阶段：询价/打样/报价/下单',
  `remark` text COLLATE utf8mb4_unicode_ci,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=21 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='客户产品/需求';


